Screen {
    background: $surface;
}

Button {
    color: $background 80%;
    &:focus {
        text-style: reverse;
    }
}

TopBar {
    height: auto;
}

.top-bar {
    width: 100%;
    height: auto;
    padding: 1 2 0 2;
    align: left middle;
}

/* compact one-line pills: tinted at rest, solid on hover */
.option {
    width: auto;
    min-width: 0;
    height: 1;
    margin-right: 1;
    padding: 0 2;
    border: none;
    text-style: bold;
    &:hover, &.-active {
        border: none;
    }
    &:focus {
        text-style: bold;
    }
}

.open-folder {
    background: $primary 15%;
    color: $primary;
    &:hover, &:focus {
        background: $primary;
        color: $background;
    }
}

.open-file {
    background: $warning 15%;
    color: $warning;
    &:hover, &:focus {
        background: $warning;
        color: $background;
    }
}

.new-file {
    background: $error 15%;
    color: $error;
    &:hover, &:focus {
        background: $error;
        color: $background;
    }
}

.main-screen {
    height: 1fr;
    padding: 1 1 0 1;
    width: 100%;
    align: left top;
    text-align: left;
}

.main-screen.expanded {
    padding: 0 1;
}

/* icon rail: borderless, one row per icon, highlight on hover */
.side-button {
    height: auto;
    Button {
        width: 4;
        min-width: 4;
        height: 1;
        margin-bottom: 1;
        padding: 0;
        border: none;
        background: transparent;
        &:hover, &.-active {
            border: none;
            background: $boost;
        }
        &:focus {
            background: $primary 25%;
            text-style: none;
        }
    }
}

SideBar {
    width: 4;
}

#side-panel {
    width: auto;
    padding: 0 1;
    background: $panel 40%;
    text-align: center;
    align: right middle;
}

#tabbed-editor {
    padding-left: 1;
}

#customizer Label {
    margin: 1;
}

#runner-output {
    border: panel $primary-darken-3;
    padding: 1 2;
}

.tabbed-editor {
    width: auto;
    align: left middle;
}

.chat-pane{
    margin: 0 1;
}

.chat-log {
    align: left top;
    padding: 0 1;
}

.user-message {
    padding: 0 1;
    color: $primary;
    text-align: left;
    width: auto;
    max-width: 70%;
    border: round $primary-darken-2;
}

.ai-message {
    padding-top: 1;
}

.chat-input {
    height: 5;
    align: center bottom;
}

Select {
    max-width: 30;
    margin-bottom: 1;
}
